{
  "name": "ensemble",
  "version": "0.0.0",
  "description": "Local orchestrator for parallel Claude Code and Codex sessions in isolated git worktrees",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ensemble": "bin/ensemble.js"
  },
  "scripts": {
    "start": "node bin/ensemble.js",
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "picomatch": "^4.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
